<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64;Win32;Any CPU</Platforms>
    <RootNamespace>WinFormsControl</RootNamespace>
    <TargetFrameworks>
      net6.0-windows;
      net48;
    </TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <Import Project="Props\OutputLibs.props" />

  <ItemGroup>
    <Compile Include="Sample/SampleControl/SampleControl.cs" />
    <Compile Include="Sample/SampleControl/SampleControl.Designer.cs" />

    <Compile Include="TextBox/TextBoxWithButton.cs" />
    <Compile Include="TextBox/TextBoxWithButton.Designer.cs" />

    <Compile Include="Utils/RectSelectForm/RectSelectForm.cs" />
    <Compile Include="Utils/RectSelectForm/RectSelectForm.Designer.cs" />
  </ItemGroup>

</Project>
